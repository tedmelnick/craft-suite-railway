//! `window.@APP@`: the page command API (`craft-web-api`, storytold/craft-libs#413) over the
//! app's own control channel, the one the desktop control server drives (`docs/control-protocol.md`).
//!
//! Added by tedmelnick/craft-suite-railway (.github/craft-web-patches): upstream @APP@ doesn't
//! install `window.@APP@` yet. This is the same module WordCraft ships (apps/wordcraft-web/src/api.rs):
//! a [`Request`] that queues a [`ControlRequest`] for the app, which answers it on its next frame,
//! and waits for the reply. A call the page gave up on still runs when the app reaches it, as it
//! does for a desktop client that timed out.

use std::rc::Rc;
use std::sync::mpsc::{Receiver, TryRecvError, channel};

use craft_web_api::methods::Methods;
use craft_web_api::page::{PageApi, Request};
use serde_json::{Value, json};
use wasm_bindgen_futures::JsFuture;
use @CRATE@::ControlRequest;

/// The app id in `window.<app>`.
const APP: &str = "@APP@";

/// How often a waiting call looks for the app's reply, in milliseconds (about a frame).
const POLL_MS: i32 = 16;

/// Put `window.@APP@` on the page and return the queue the app drains each frame. An existing
/// `window.@APP@` keeps the functions it already has.
pub fn install(ctx: egui::Context) -> Receiver<ControlRequest> {
    let (queue, requests) = channel::<ControlRequest>();
    let request: Request = Rc::new(move |method: String, params: Value| {
        let (control, reply) = ControlRequest::new(method, params);
        if queue.send(control).is_err() {
            return Box::pin(async { json!({"ok": false, "error": "the app is not running"}) });
        }
        ctx.request_repaint();
        Box::pin(wait(reply))
    });
    if let Err(e) = Rc::new(PageApi::new(APP, Methods::default(), request)).install() {
        log::warn!("couldn't install window.{APP}: {e:?}");
    }
    requests
}

/// The app's reply, polled about once a frame.
async fn wait(reply: Receiver<Value>) -> Value {
    loop {
        match reply.try_recv() {
            Ok(reply) => return reply,
            Err(TryRecvError::Empty) => sleep(POLL_MS).await,
            Err(TryRecvError::Disconnected) => return json!({"ok": false, "error": "the app dropped the request"}),
        }
    }
}

async fn sleep(ms: i32) {
    let promise = js_sys::Promise::new(&mut |resolve, _| {
        if let Some(window) = web_sys::window() {
            let _ = window.set_timeout_with_callback_and_timeout_and_arguments_0(&resolve, ms);
        }
    });
    let _ = JsFuture::from(promise).await;
}
